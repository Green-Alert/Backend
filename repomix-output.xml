      });
    } catch (error) {
      if (error.statusCode) {
        return errorResponse(res, error.message, error.statusCode);
      }
      throw error;
    }

    if (!user) {
      return errorResponse(res, 'No fue posible crear la cuenta con este correo.', 400);
