          background: #059669;
          color: #ffffff;
          padding: 28px 20px;
          text-align: center;
        }
        .header h1 {
          margin: 0;
          font-size: 28px;
          font-weight: 700;
        }
        .content {
          padding: 30px 22px;
        }
        .content h2 {
          margin: 0 0 18px;
          color: #111827;
          font-size: 22px;
        }
        .message {
          color: #4b5563;
          margin-bottom: 18px;
        }
        .panel {
          background-color: #f0fdf4;
          border-left: 4px solid #10b981;
          padding: 15px 18px;
          margin: 20px 0;
          border-radius: 4px;
        }
        .panel h3 {
          margin: 0 0 10px;
          color: #047857;
          font-size: 16px;
        }
        .panel ul {
          padding-left: 20px;
          margin: 0;
        }
        .footer {
          background-color: #f9fafb;
          padding: 18px 20px;
