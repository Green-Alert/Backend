  });

  try {
    const { port } = server.address();
    const cases = [
      ['GET', '/notificaciones'],
      ['GET', '/notificaciones/contador'],
      ['PATCH', '/notificaciones/marcar-todas'],
      ['PATCH', '/notificaciones/notif-1/leida'],
      ['DELETE', '/notificaciones/notif-1'],
    ];

