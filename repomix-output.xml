const buildReportesFilter = ({
  estado,
  tipo_contaminacion,
  nivel_severidad,
  municipio,
} = {}) => {
  const conditions = ['r.deleted_at IS NULL'];
  const params = [];

  if (estado) {
    conditions.push('r.estado = ?');
    params.push(estado);
