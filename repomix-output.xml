import { CATEGORIAS_FALLBACK } from '../models/categoria-riesgo.model.js';

const CATEGORY_HINTS = [
  {
    categoria: 'agua',
    subcategoria: 'vertimiento',
    severidad: 'alto',
    keywords: ['agua', 'rio', 'quebrada', 'inundacion', 'vertimiento', 'alcantarilla'],
