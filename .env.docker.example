DB_HOST=tu-host-aiven.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=tu-password-aiven
DB_NAME=defaultdb
DB_SSL=true
# Opcional pero recomendado: descarga el CA de Aiven y guardalo en certs/ca.pem.
# Si lo usas, deja esta ruta exactamente asi porque /certs se monta dentro del contenedor.
DB_SSL_CA_PATH=/certs/ca.pem

JWT_SECRET=cambia_este_secreto
CORS_ORIGIN=http://localhost:5173,http://localhost
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
